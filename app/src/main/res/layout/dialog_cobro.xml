<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💳 Procesar Pago y Facturación"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="12dp" />

        <!-- Tarjeta de Totales -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#0F1D38"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvCobroTotalUsd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00 USD"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvCobroTotalBs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00 Bs (Tasa Oficial)"
                    android:textColor="#34D399"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Selección de Cliente -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Datos del Cliente (Opcional)"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <EditText
                android:id="@+id/etClienteDoc"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="C.I. / RIF (V-000)"
                android:paddingHorizontal="10dp"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etClienteNom"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.4"
                android:background="@drawable/bg_input"
                android:hint="Nombre Cliente"
                android:paddingHorizontal="10dp"
                android:textSize="12sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Selección de Método de Pago -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Método de Pago"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spMetodoPago"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="14dp" />

        <!-- Monto Recibido y Vuelto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monto Entregado por el Cliente"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etMontoEntregado"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_input"
            android:hint="0.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:inputType="numberDecimal"
            android:textColor="#0F172A"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvVueltoCalculado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vuelto: $0.00 (0.00 Bs)"
            android:textColor="#00A859"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinalizarVenta"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="✓ Emitir Factura y Finalizar"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#00A859"
            app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>
