<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvTituloInv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦 Gestión de Producto"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="16dp" />

        <!-- Nombre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Producto *"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etInvNombre"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:hint="Ej. Harina PAN Blanca 1kg"
            android:layout_marginBottom="12dp" />

        <!-- Código de barras y Departamento -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Código de Barras"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/etInvCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:hint="759100..." />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Departamento"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />
                <Spinner
                    android:id="@+id/spInvDepto"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input" />
            </LinearLayout>
        </LinearLayout>

        <!-- Costo USD y Precio Detal USD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Costo ($)"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/etInvCosto"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:hint="0.00"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precio Venta ($) *"
                    android:textColor="#00A859"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/etInvPrecio"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp"
                    android:textColor="#00A859"
                    android:textStyle="bold"
                    android:hint="0.00"
                    android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>

        <!-- Stock y Toggles -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stock Inicial / Existencia"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etInvStock"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:hint="10.0"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/cbInvPesado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚖️ Producto pesado (Venta por Balanza/Kilos)"
            android:textColor="#1E293B"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/cbInvMayor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏷️ Aplica precio al mayor"
            android:textColor="#1E293B"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/layoutPreciosMayor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="6dp">

            <EditText
                android:id="@+id/etInvCantMayor"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Mínimo (Ej. 3)"
                android:paddingHorizontal="10dp"
                android:textSize="12sp"
                android:inputType="number"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etInvPrecioMayor"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Precio Mayor ($)"
                android:paddingHorizontal="10dp"
                android:textSize="12sp"
                android:inputType="numberDecimal"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInvCancelar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:textColor="#64748B"
                app:backgroundTint="#F1F5F9"
                app:cornerRadius="12dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInvGuardar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardar Producto"
                android:textColor="#FFFFFF"
                app:backgroundTint="#00A859"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
